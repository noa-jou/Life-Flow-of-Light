{
  "name": "life-flow-of-light-backend",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "test": "npm run typecheck:tests && node --import tsx --test test/*.test.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "seed": "tsx src/seed.ts",
    "test:morse": "node --import tsx --test test/morse.test.ts test/morse-routes.test.ts",
    "typecheck:tests": "tsc --project test/tsconfig.json",
    "test:bulbs": "node --import tsx --test test/bulb-routes.test.ts",
    "test:heartbeat": "node --import tsx --test test/heartbeat-routes.test.ts",
    "test:timeline": "node --import tsx --test test/light-session-routes.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
